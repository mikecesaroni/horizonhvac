---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { serviceAreas } from "../../data/serviceAreas";

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
---

<BaseLayout title={area.name}>
  <PageHero eyebrow="Service Area" title={`HVAC Service in ${area.name}`} />
  <section class="mx-auto max-w-4xl px-4 py-16 text-brand-ink/80 space-y-4">
    <!-- TODO: replace with real local service-area copy -->
    <p>Content for {area.name} coming soon.</p>
    <a href="/contact" class="inline-block mt-4 rounded-md bg-brand-green px-6 py-3 font-semibold text-white hover:opacity-90">
      Book Service
    </a>
  </section>
</BaseLayout>
