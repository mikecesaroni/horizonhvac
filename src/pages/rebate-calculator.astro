---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Rebate Calculator">
  <PageHero
    eyebrow="Rhode Island Homeowners"
    title="Calculate Your Heat Pump Rebate"
    description="Up to $11,500 from Clean Heat RI + federal credits. We file the paperwork."
  />
  <section class="mx-auto max-w-2xl px-4 py-16">
    <!--
      TODO: this is a lead-capture form, not a real rebate calculation engine
      (unconfirmed whether the current site actually computes real numbers).
      Wire the form submission to a GoHighLevel form/webhook once account details are available.
    -->
    <form class="space-y-4 rounded-2xl border border-brand-green/10 p-8 shadow-sm">
      <div>
        <label class="block text-sm font-semibold text-brand-ink" for="name">Full Name</label>
        <input id="name" name="name" type="text" required class="mt-1 w-full rounded-md border border-brand-ink/20 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-brand-ink" for="phone">Phone Number</label>
        <input id="phone" name="phone" type="tel" required class="mt-1 w-full rounded-md border border-brand-ink/20 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-brand-ink" for="address">Home Address</label>
        <input id="address" name="address" type="text" required class="mt-1 w-full rounded-md border border-brand-ink/20 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-semibold text-brand-ink" for="system">Current Heating System</label>
        <select id="system" name="system" class="mt-1 w-full rounded-md border border-brand-ink/20 px-3 py-2">
          <option>Oil</option>
          <option>Gas</option>
          <option>Electric Baseboard</option>
          <option>Other</option>
        </select>
      </div>
      <button type="submit" class="w-full rounded-md bg-brand-green px-6 py-3 font-semibold text-white hover:opacity-90">
        Calculate My Savings
      </button>
    </form>
  </section>
</BaseLayout>
