---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MembershipPlans from "../components/MembershipPlans.astro";
import FaqSection from "../components/FaqSection.astro";
import { membershipPlans, membershipTerms } from "../data/plans";

// The single home for Comfort Club memberships, reachable from the top menu.
// The maintenance-plan question was one the AI visibility scan showed Horizon
// losing outright, and priced plans are what get quoted back in answers.

const metaTitle = "HVAC Maintenance Plans in Rhode Island | Horizon HVAC Comfort Club";
const metaDescription =
  "Horizon HVAC Comfort Club plans from $24/month per system: annual or twice-yearly tune-ups, priority scheduling, 10-15% off repair labor and parts, and a free month when you pay annually. Serving all of Rhode Island.";

const whyItPays = [
  "It's been over a year since your last tune-up",
  "You want to avoid an emergency breakdown during peak season",
  "You'd like to keep your manufacturer's warranty valid, many require documented annual service",
  "Your energy bills are creeping up year over year",
  "You'd rather pay a predictable monthly amount than an unpredictable repair bill",
];

const faqs = [
  {
    q: "What's included in a Horizon HVAC Comfort Club plan?",
    a: "Essential is $24 per month per system: one annual tune-up, 10% off repair labor and parts, a priority scheduling target within 48 hours, thermostat calibration, and filter replacement labor during the visit. Comfort Club is $39 per month: two tune-ups a year in spring and fall, 15% off repair labor and parts, an annual indoor air quality inspection, 5% off coil cleaning and boiler descaling, and a $250 credit toward future equipment replacement. Total Comfort is $59 per month: everything in Comfort Club plus your first two diagnostic or service calls free each membership year, VIP priority scheduling, one chemical A/C coil cleaning a year if needed, one annual boiler descaling on eligible equipment, and a $500 equipment credit.",
  },
  {
    q: "How much does an HVAC maintenance plan cost in Rhode Island?",
    a: "Horizon HVAC plans are $24, $39, or $59 per month per enrolled system, which is $288, $468, or $708 across a year. Paying for the year upfront gets you a month free, bringing it to $264, $429, or $649.",
  },
  {
    q: "Do I still pay a diagnostic fee as a member?",
    a: "On the Essential plan the standard diagnostic and service-call fee is $179, and it is waived when the recommended work is performed. Total Comfort includes your first two diagnostic or service calls free each membership year on the covered system, with any further calls at $139 each. Fee waivers apply only to the covered system, and repair labor and parts are billed separately at your plan discount.",
  },
  {
    q: "What does it cost to add a second system?",
    a: "Comfort Club and Total Comfort members get 50% off membership for each additional enrolled system, so a second system is $19.50 per month on Comfort Club and $29.50 per month on Total Comfort. The Essential plan is full price for each additional system, at $24 per month each.",
  },
  {
    q: "Is a maintenance plan worth it, or should I just call when something needs doing?",
    a: "A plan wins when you value the extras: the seasonal visits happen without you having to remember, you get priority scheduling during the weeks everyone else is waiting, and you get 10-15% off repair labor and parts. The equipment replacement credit matters too, since $250 or $500 comes off a future system. If you would rather book a one-off visit, call 401-425-9879 and we will quote it.",
  },
  {
    q: "When are the tune-up visits scheduled?",
    a: "On the two-visit plans, the air conditioning check happens in spring before the first hot stretch and the heating check in fall before the system gets turned on for the season, both ahead of peak demand rather than during it. We send seasonal reminders by email and text, so you do not have to track it.",
  },
  {
    q: "Do I need a plan for each system in the house?",
    a: "Membership benefits apply to each enrolled HVAC system, and the plans cover residential systems only. Homes with genuinely separate equipment, such as two furnaces or a boiler plus separate central air, enroll each system, with the additional-system discount applying on Comfort Club and Total Comfort.",
  },
  {
    q: "What happens to my membership if I sell the house?",
    a: "Membership is transferable to a new homeowner, subject to Horizon HVAC's transfer policy. Any outstanding balance has to be paid before the transfer goes through.",
  },
  {
    q: "Does regular maintenance actually save money?",
    a: "Yes. A dirty or neglected system works harder to hit the same temperature, which shows up directly on your energy bill, and small issues caught early are far cheaper than the breakdown they would eventually become. Documented annual service also keeps most manufacturer warranties valid, which matters a great deal if a major component fails.",
  },
  {
    q: "Do you offer maintenance plans across all of Rhode Island?",
    a: "Yes, in all 39 Rhode Island cities and towns, with no extra trip charge for being outside a small service radius.",
  },
];

// Priced plans are exactly the kind of concrete, checkable detail that gets
// quoted back in answers about annual service contracts.
const planSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "HVAC maintenance plan",
  name: "Horizon HVAC Maintenance Plans",
  description: metaDescription,
  provider: { "@id": "https://horizonhvacinc.com/#business" },
  areaServed: { "@type": "State", name: "Rhode Island" },
  offers: membershipPlans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.monthly.replace("$", ""),
    priceCurrency: "USD",
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: plan.monthly.replace("$", ""),
      priceCurrency: "USD",
      unitText: "month per system",
    },
    description: plan.benefits.join("; "),
    url: "https://horizonhvacinc.com/maintenance-plans",
  })),
};
---

<BaseLayout title="Maintenance Plans" fullTitle={metaTitle} description={metaDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(planSchema)} />

  <PageHero
    eyebrow="Comfort Club"
    title="HVAC Maintenance Plans"
    description="Predictable monthly cost, priority scheduling, and a discount on every repair, instead of waiting for something to break."
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Maintenance Plans", href: "/maintenance-plans" },
    ]}
  />

  <MembershipPlans />

  <section class="bg-brand-green/5 py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="text-3xl font-extrabold text-brand-ink text-center">Why a Plan Pays for Itself</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {whyItPays.map((item) => (
          <li class="flex gap-3 rounded-lg border border-brand-green/10 bg-white p-4 text-brand-ink/80">
            <span class="shrink-0 font-bold text-brand-green">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="text-3xl font-extrabold text-brand-ink text-center">Membership Terms</h2>
      <p class="mt-3 text-center text-brand-ink/70">
        The fine print, in plain sight rather than buried at the bottom of a contract.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {membershipTerms.map((term) => (
          <div class="rounded-xl border border-brand-green/15 p-5">
            <h3 class="text-sm font-bold uppercase tracking-wide text-brand-green">{term.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-ink/75">{term.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 rounded-2xl bg-brand-green/5 p-8 text-center">
        <h3 class="text-xl font-bold text-brand-ink">Not ready for a plan?</h3>
        <p class="mt-2 text-brand-ink/75">
          You can book a one-time seasonal visit instead, call us and we'll quote it before we schedule, with no
          commitment either way.
        </p>
        <a
          href="tel:14014259879"
          class="mt-5 inline-block rounded-full bg-brand-green px-8 py-3 font-bold text-white shadow-lg hover:opacity-90"
        >
          Call 401-425-9879
        </a>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} title="Maintenance Plans: Frequently Asked Questions" />
</BaseLayout>
