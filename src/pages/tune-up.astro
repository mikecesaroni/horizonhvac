---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqSection from "../components/FaqSection.astro";
import { tuneUp } from "../data/tuneUp";

// The "best company for annual furnace maintenance in RI" answer named five
// competitors and specifically noted that oil dealers win because the tune-up is
// bundled into a priced service plan. A named, flat-rate, published price is the
// single most quotable thing on a maintenance page.
//
// HEATING ONLY. The checklist below mirrors the service as defined in Horizon's
// Housecall Pro price book ("$149 Tune up Special - Heater / Furnace tune-up").
// Do not add cooling work to this page: air conditioning is not part of this
// offer, and the page has an FAQ that says so explicitly so customers don't
// arrive expecting their AC to be serviced.

const PRICE = tuneUp.price;
const PHONE_DISPLAY = "401-425-9879";

const metaTitle = `$${PRICE} Heating & Furnace Tune-Up in Rhode Island | Horizon HVAC`;
const metaDescription =
  `Flat-rate $${PRICE} heating and furnace tune-up anywhere in Rhode Island. Burner cleaning, heat exchanger and gas pressure inspection, airflow check, and a written recommendation when we're done.`;

// Why the checklist items above matter — written from the checklist itself
// rather than inventing additional scope.
const whyItMatters = [
  {
    title: "The heat exchanger inspection is the safety one",
    body: "A cracked heat exchanger is what lets combustion gases, including carbon monoxide, into the air moving through your house. It is invisible without an inspection, and it is the single most important reason not to skip a heating tune-up on a gas system.",
  },
  {
    title: "Burners and gas pressure decide what you burn",
    body: "Dirty burners and incorrect gas pressure make the furnace work harder for the same heat, which lands directly on your winter fuel bill. Cleaning and adjusting them is the part of the visit that pays for itself.",
  },
  {
    title: "Blower, filter and airflow protect the equipment",
    body: "Restricted airflow makes a furnace overheat and short-cycle, which stresses every component downstream and is a common cause of mid-winter failures. A clean blower and an unrestricted filter are what keep heat moving out of the unit and into the house.",
  },
  {
    title: "You get a recommendation, not a sales pitch",
    body: "When the visit is finished you receive a recommendation covering any further maintenance or repair your system needs. You decide what happens next — approving anything is entirely optional.",
  },
];

const faqs = [
  {
    q: `What does the $${PRICE} heating tune-up include?`,
    a: `A full inspection and service of one heating system: clean the blower, clean and adjust the burners, inspect the heat exchanger, inspect gas pressure and flame, inspect the igniter or pilot light, inspect the filter, and check airflow. When it's finished you receive a recommendation for any further maintenance or repair your system needs. It's a flat $${PRICE} for the visit, quoted before we arrive.`,
  },
  {
    q: "Does this cover my air conditioner too?",
    a: `No. The $${PRICE} special is a heating and furnace tune-up only. Air conditioning service is a separate visit — call ${PHONE_DISPLAY} and we'll quote it for you. If you want both heating and cooling covered through the year, a maintenance plan is usually the better value.`,
  },
  {
    q: `Is the $${PRICE} price per system or per visit?`,
    a: `It covers one heating system. If your home has two furnaces, or a furnace plus a separate heating system for an addition, each is quoted individually — call ${PHONE_DISPLAY} and we'll give you the exact number before scheduling.`,
  },
  {
    q: "When should I schedule my heating tune-up?",
    a: "Ideally in the fall, before the heat gets turned on for the season — ahead of peak demand rather than during it. The worst time to discover a problem is the first genuinely cold night, when every contractor in Rhode Island is already booked.",
  },
  {
    q: "How often does a furnace need a tune-up?",
    a: "Once a year. Most manufacturer warranties also require documented annual service to stay valid, which matters a great deal if a major component fails while the system is still covered.",
  },
  {
    q: "Does a tune-up actually save money, or is it just an upsell?",
    a: "A dirty or out-of-adjustment furnace burns more fuel to hit the same temperature, and that shows up directly on your winter bill. The small problems a tune-up catches are also far cheaper than the mid-January breakdown they would otherwise become. You get a written recommendation and decide for yourself what, if anything, to do next.",
  },
  {
    q: "What if you find something wrong during the tune-up?",
    a: `We tell you what we found, show you the issue, and quote the repair upfront. You're never obligated to have the work done at that visit, and the $${PRICE} stands whether or not you approve any repair.`,
  },
  {
    q: "Do you offer heating tune-ups in my town?",
    a: "Yes, anywhere in Rhode Island — all 39 cities and towns, from Woonsocket down to Westerly and out to Newport and Block Island.",
  },
];

const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Heating system tune-up",
  name: `$${PRICE} Heating & Furnace Tune-Up`,
  description: metaDescription,
  provider: { "@id": "https://horizonhvacinc.com/#business" },
  areaServed: { "@type": "State", name: "Rhode Island" },
  offers: {
    "@type": "Offer",
    price: PRICE,
    priceCurrency: "USD",
    url: "https://horizonhvacinc.com/tune-up",
    availability: "https://schema.org/InStock",
  },
};
---

<BaseLayout title={`$${PRICE} Heating Tune-Up`} fullTitle={metaTitle} description={metaDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(offerSchema)} />

  <PageHero
    eyebrow="Heating Season Special"
    title={`The $${PRICE} Heating Tune-Up Special`}
    description="A full inspection and service of your heater or furnace, at one flat published price, anywhere in Rhode Island."
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: `$${PRICE} Heating Tune-Up`, href: "/tune-up" },
    ]}
  />

  <section class="bg-white py-14">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <p class="text-6xl font-extrabold tracking-tight text-brand-green">${PRICE}</p>
      <p class="mt-2 text-lg font-semibold text-brand-ink">per heating system, flat rate</p>
      <p class="mt-4 text-brand-ink/75 leading-relaxed">
        Keep your home warm and safe through the winter. No trip fee, no diagnostic add-on, and no obligation to
        approve any repair we find — you get the price before we schedule, and a written recommendation when we
        leave.
      </p>
      <button
        type="button"
        data-open-quote-form
        class="mt-8 inline-block rounded-full bg-brand-gold px-10 py-4 text-lg font-bold text-brand-ink shadow-lg hover:opacity-90 transition-opacity"
      >
        Book a ${PRICE} Heating Tune-Up
      </button>
      <p class="mt-4 text-sm text-brand-ink/60">
        Or call <a href="tel:14014259879" class="font-semibold text-brand-green hover:underline">{PHONE_DISPLAY}</a>
      </p>
    </div>
  </section>

  <section class="bg-brand-green/5 py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="text-3xl font-extrabold text-brand-ink text-center">What the Visit Covers</h2>
      <p class="mt-3 text-center text-brand-ink/70">
        Seven checks that keep your heating system in good working order.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {tuneUp.checklist.map((item) => (
          <li class="flex gap-3 rounded-lg border border-brand-green/10 bg-white p-4 font-semibold text-brand-ink/80">
            <span class="shrink-0 font-bold text-brand-green">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-center text-brand-ink/75">
        {tuneUp.recommendation}
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="text-3xl font-extrabold text-brand-ink text-center">Why These Checks Matter</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {whyItMatters.map((s) => (
          <div class="rounded-xl border border-brand-green/15 p-6">
            <h3 class="font-bold text-brand-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-brand-ink/75 leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 rounded-2xl bg-brand-green/5 p-8 text-center">
        <p class="text-brand-ink/80">
          Want cooling covered as well, or your heating handled every year without having to remember? A
          maintenance plan includes seasonal visits, priority scheduling, and a discount on any repair.
        </p>
        <a href="/maintenance-plans" class="mt-4 inline-block font-semibold text-brand-green hover:underline">
          Compare maintenance plans →
        </a>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} title={`The $${PRICE} Heating Tune-Up — Frequently Asked Questions`} />
</BaseLayout>
