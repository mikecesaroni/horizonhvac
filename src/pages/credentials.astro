---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqSection from "../components/FaqSection.astro";
import { credentials, manufacturerCertifications, programs } from "../data/credentials";

// Four of fifteen AI answers about RI HVAC were largely about how to verify a
// contractor's licensing, and one warned that Rhode Island licenses individuals
// rather than firms — so "a company can look legitimate while the guy at your
// house isn't the license holder." Publishing checkable numbers in plain text is
// what turns a claim into a verifiable fact an assistant will repeat.
//
// Values live in src/data/credentials.ts. Anything still null is skipped entirely
// rather than rendered as a placeholder, so this page never publishes a number
// the business does not actually hold.

const filled = credentials.filter((c) => c.value);

const metaTitle = "Licensing, Insurance & Credentials | Horizon HVAC Rhode Island";
const metaDescription =
  "Horizon HVAC's Rhode Island licensing, registration, and insurance details, plus the official state lookup tools you can use to verify any HVAC contractor yourself.";

const faqs = [
  {
    q: "Is Horizon HVAC licensed and insured in Rhode Island?",
    a: "Yes. Horizon HVAC is a licensed and insured Rhode Island HVAC contractor carrying general liability and workers' compensation coverage, and a certificate of insurance is available on request before work begins.",
  },
  {
    q: "How do I verify a Rhode Island HVAC contractor's license myself?",
    a: "Rhode Island licenses individual technicians through the Department of Labor and Training's Division of Professional Regulation, and registers contracting businesses through the Contractors' Registration and Licensing Board at dbr.ri.gov. Both maintain free public lookup tools — search the license or registration number the contractor gives you and confirm it is active before any work starts.",
  },
  {
    q: "Why does it matter that Rhode Island licenses individuals, not companies?",
    a: "Because a company can hold a business registration while the technician actually standing in your home is not a license holder. It is fair to ask which licensed individual is responsible for your job, and any legitimate contractor will answer without hesitation.",
  },
  {
    q: "What is EPA 608 certification and why should I care?",
    a: "It is the federal certification required to purchase and handle refrigerants. Any technician opening a sealed refrigerant system on your air conditioner or heat pump is legally required to hold it. Someone working on your AC without it is a real red flag.",
  },
  {
    q: "Should I ask for proof of insurance before work starts?",
    a: "Yes, and it should be no trouble to produce. If a contractor is uninsured and someone is injured on your property or your home is damaged, that exposure can land on you as the homeowner.",
  },
];
---

<BaseLayout title="Licensing & Credentials" fullTitle={metaTitle} description={metaDescription}>
  <PageHero
    eyebrow="Verify Us"
    title="Licensing, Insurance & Credentials"
    description="Our credentials in plain text, plus the state tools to check them — and to check anyone else you're considering."
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Credentials", href: "/credentials" },
    ]}
  />

  {filled.length > 0 && (
    <section class="bg-white py-16">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-3xl font-extrabold text-brand-ink text-center">Our Credentials</h2>
        <div class="mt-8 space-y-4">
          {filled.map((c) => (
            <div class="rounded-xl border border-brand-green/15 p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-bold text-brand-ink">{c.label}</h3>
                <p class="font-mono text-lg font-bold text-brand-green">{c.value}</p>
              </div>
              <p class="mt-2 text-sm text-brand-ink/70 leading-relaxed">{c.note}</p>
              {c.verifyUrl && (
                <a
                  href={c.verifyUrl}
                  rel="nofollow noopener"
                  target="_blank"
                  class="mt-3 inline-block text-sm font-semibold text-brand-green hover:underline"
                >
                  {c.verifyLabel ?? "Verify independently"} →
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {manufacturerCertifications.length > 0 && (
    <section class="bg-brand-green/5 py-16">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-3xl font-extrabold text-brand-ink text-center">Factory Certifications</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {manufacturerCertifications.map((m) => (
            <div class="rounded-xl border border-brand-green/15 bg-white p-6">
              <h3 class="font-bold text-brand-ink">{m.brand}</h3>
              <p class="mt-1 text-brand-green font-semibold">{m.level}</p>
              {m.warranty && <p class="mt-2 text-sm text-brand-ink/70">{m.warranty}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-3xl font-extrabold text-brand-ink text-center">How to Check Any RI Contractor</h2>
      <p class="mt-4 text-center text-brand-ink/75 leading-relaxed">
        We would rather you verify us than take our word for it — and we would rather you check whoever else you are
        considering, too. Rhode Island makes both free and public.
      </p>
      <div class="mt-8 space-y-4">
        <div class="rounded-xl border border-brand-green/15 p-6">
          <h3 class="font-bold text-brand-ink">RI Contractors' Registration and Licensing Board (CRLB)</h3>
          <p class="mt-2 text-sm text-brand-ink/70 leading-relaxed">
            Look up a contractor's registration, see whether it is active, and check for complaints or violations
            filed against it.
          </p>
          <a
            href="https://dbr.ri.gov/divisions/contractors"
            rel="nofollow noopener"
            target="_blank"
            class="mt-3 inline-block text-sm font-semibold text-brand-green hover:underline"
          >
            dbr.ri.gov contractor lookup →
          </a>
        </div>
        <div class="rounded-xl border border-brand-green/15 p-6">
          <h3 class="font-bold text-brand-ink">RI DLT Division of Professional Regulation</h3>
          <p class="mt-2 text-sm text-brand-ink/70 leading-relaxed">
            Rhode Island licenses individual technicians here. This is where you confirm that the person doing the
            work — not just the company name on the truck — actually holds a current license.
          </p>
          <a
            href="https://dlt.ri.gov/individuals/professional-regulation"
            rel="nofollow noopener"
            target="_blank"
            class="mt-3 inline-block text-sm font-semibold text-brand-green hover:underline"
          >
            dlt.ri.gov license lookup →
          </a>
        </div>
        <div class="rounded-xl border border-brand-green/15 p-6">
          <h3 class="font-bold text-brand-ink">Ask for a certificate of insurance</h3>
          <p class="mt-2 text-sm text-brand-ink/70 leading-relaxed">
            Any legitimate contractor can produce general liability and workers' compensation certificates on
            request. If a contractor is uninsured, an injury or accident at your home can become your problem.
          </p>
        </div>
      </div>
    </div>
  </section>

  {programs.length > 0 && (
    <section class="bg-brand-green/5 py-16">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-3xl font-extrabold text-brand-ink text-center">Programs We Participate In</h2>
        <div class="mt-8 space-y-4">
          {programs.map((p) => (
            <div class="rounded-xl border border-brand-green/15 bg-white p-6">
              <h3 class="font-bold text-brand-ink">{p.name}</h3>
              <p class="mt-2 text-sm text-brand-ink/70 leading-relaxed">{p.detail}</p>
              {p.url && (
                <a
                  href={p.url}
                  rel="nofollow noopener"
                  target="_blank"
                  class="mt-3 inline-block text-sm font-semibold text-brand-green hover:underline"
                >
                  Learn more →
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <FaqSection faqs={faqs} title="Licensing & Verification — Frequently Asked Questions" />

</BaseLayout>
