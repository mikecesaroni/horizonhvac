---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import FaqSection from "../../components/FaqSection.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { "@type": "Organization", name: "Horizon HVAC" },
  publisher: { "@id": "https://horizonhvacinc.com/#business" },
  mainEntityOfPage: new URL(`/blog/${post.id}`, Astro.site).toString(),
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />

  <PageHero
    eyebrow="Blog"
    title={post.data.title}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: post.data.title, href: `/blog/${post.id}` },
    ]}
  />
  <article class="mx-auto max-w-3xl px-4 py-16 prose">
    <Content />
  </article>

  {post.data.faqs && post.data.faqs.length > 0 && (
    <FaqSection faqs={post.data.faqs} title="Related Questions" />
  )}
</BaseLayout>
