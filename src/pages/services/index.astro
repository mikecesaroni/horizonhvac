---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { services } from "../../data/services";
---

<BaseLayout title="Services">
  <PageHero eyebrow="What We Do" title="Our Services" />
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a
          href={`/services/${service.slug}`}
          class="rounded-xl border border-brand-green/10 p-6 hover:shadow-md transition-shadow"
        >
          <h2 class="text-xl font-bold text-brand-ink">{service.name}</h2>
          <p class="mt-2 text-brand-ink/70">{service.summary}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
