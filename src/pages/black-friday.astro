---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetaPixel from "../components/MetaPixel.astro";

// Dedicated Black Friday / Cyber Monday landing page for the Meta campaign.
//
// Separate from /free-estimate on purpose: it carries the same pixel but a
// different offer, a different lead source label in GoHighLevel, and the dark
// neon treatment from the ad creative, so the page a click lands on looks like
// the ad it came from. That visual continuity is most of why a dedicated page
// converts better than pointing seasonal ads at the generic estimate page.
//
// TWO THINGS TO CONFIRM BEFORE SPENDING ON THIS:
//   1. SALE_ENDS below. Set from the 2026 calendar (Cyber Monday, 30 November).
//      Change it if the promotion runs to a different date.
//   2. The fine print states only what the creative states: "up to" and
//      "qualifying". It deliberately invents no exclusions, no minimum spend
//      and no financing terms. Add the real conditions here before running
//      traffic, because a published discount is a commitment.

const PHONE_DISPLAY = "401-425-9879";
const PHONE_HREF = "tel:14014259879";
const SALE_ENDS = "Cyber Monday, November 30th";

const metaTitle = "Black Friday & Cyber Monday HVAC Sale | Up to $1,000 Off | Horizon HVAC";
const metaDescription =
  "Horizon HVAC Black Friday and Cyber Monday sale: up to $1,000 off qualifying new HVAC systems. Free estimates across Rhode Island & Massachusetts.";

const highlights = [
  {
    title: "Up to $1,000 off",
    body: "Applied to qualifying new system installations. We confirm your exact discount when we quote the job.",
  },
  {
    title: "Free estimate, no obligation",
    body: "We look at the actual system, size it properly, and give you a written price. You decide from there.",
  },
  {
    title: "Financing available",
    body: "Spread the cost rather than paying it all upfront. Ask about terms when you book.",
  },
];

const systems = [
  "Ductless mini-splits, single zone and multi zone",
  "Heat pumps, including cold-climate systems",
  "Central air conditioning",
  "Furnaces and air handlers",
];
---

<BaseLayout
  title="Black Friday Sale"
  fullTitle={metaTitle}
  description={metaDescription}
  ogImage="/offers/black-friday-og.jpg"
  minimal={true}
  noindex={true}
>
  <MetaPixel slot="head" pixelId="1537210114875536" />

  <!-- Dark neon ground taken from the ad creative, not the site's usual green. -->
  <section class="relative isolate flex-1 overflow-hidden bg-[#060A08] text-white">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-70"
      style="background:
        radial-gradient(60% 50% at 15% 10%, rgba(34,197,94,.30), transparent 70%),
        radial-gradient(55% 45% at 85% 20%, rgba(147,51,234,.28), transparent 70%),
        radial-gradient(60% 55% at 50% 100%, rgba(16,185,129,.22), transparent 70%);"
    >
    </div>

    <div class="mx-auto grid w-full max-w-6xl items-center gap-8 px-4 py-10 lg:grid-cols-2 lg:gap-12 lg:py-14">
      <div class="text-center lg:text-left">
        <p class="text-xs sm:text-sm font-bold uppercase tracking-[0.2em] text-[#4ADE80]">
          Black Friday &amp; Cyber Monday
        </p>

        <h1 class="mt-3 text-3xl sm:text-5xl font-extrabold uppercase leading-[1.05] drop-shadow-[0_0_25px_rgba(74,222,128,0.35)]">
          Up To <span class="text-[#4ADE80]">$1,000 Off</span><br class="hidden sm:block" /> New HVAC Systems
        </h1>

        <p class="mt-4 text-base sm:text-lg font-semibold text-white/80">
          On qualifying new system installations. Book your free estimate before the sale ends.
        </p>

        <img
          src="/offers/black-friday.webp"
          alt="Horizon HVAC Black Friday and Cyber Monday sale, up to $1,000 off qualifying new HVAC systems"
          width="1080"
          height="1080"
          loading="eager"
          class="mx-auto mt-7 w-full max-w-xs rounded-2xl border border-[#4ADE80]/25 shadow-[0_0_45px_rgba(74,222,128,0.18)] lg:mx-0 lg:max-w-sm"
        />

        <div class="mt-7 grid gap-3 text-left">
          {highlights.map((item) => (
            <div class="rounded-xl border border-white/10 bg-white/[0.04] p-4">
              <p class="text-sm font-bold uppercase tracking-wide text-[#4ADE80]">{item.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-white/75">{item.body}</p>
            </div>
          ))}
        </div>

        <div class="mt-7 rounded-xl border border-white/10 bg-white/[0.04] p-4 text-left">
          <p class="text-sm font-bold uppercase tracking-wide text-white/90">Systems included</p>
          <ul class="mt-2 grid gap-1.5 text-sm text-white/75 sm:grid-cols-2">
            {systems.map((s) => (
              <li class="flex gap-2">
                <span class="shrink-0 font-bold text-[#4ADE80]">✓</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mx-auto w-full max-w-md lg:sticky lg:top-6">
        <form
          id="black-friday-form"
          class="space-y-3 rounded-3xl border-2 border-[#4ADE80]/40 bg-[#0B1210]/90 p-5 sm:p-6 text-left shadow-[0_0_50px_rgba(74,222,128,0.15)]"
        >
          <div class="text-center">
            <p class="text-lg sm:text-xl font-extrabold text-white">Claim Your Black Friday Discount</p>
            <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-[#4ADE80]">
              Offer ends {SALE_ENDS}
            </p>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <input
              type="text"
              name="firstName"
              placeholder="First Name"
              required
              class="w-full rounded-md border-2 border-white/15 bg-white px-3 py-2.5 text-sm text-brand-ink placeholder:text-brand-ink/50"
            />
            <input
              type="text"
              name="lastName"
              placeholder="Last Name"
              required
              class="w-full rounded-md border-2 border-white/15 bg-white px-3 py-2.5 text-sm text-brand-ink placeholder:text-brand-ink/50"
            />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <input
              type="tel"
              name="phone"
              placeholder="Phone Number"
              required
              class="w-full rounded-md border-2 border-white/15 bg-white px-3 py-2.5 text-sm text-brand-ink placeholder:text-brand-ink/50"
            />
            <input
              type="email"
              name="email"
              placeholder="Email Address"
              required
              class="w-full rounded-md border-2 border-white/15 bg-white px-3 py-2.5 text-sm text-brand-ink placeholder:text-brand-ink/50"
            />
          </div>
          <input
            type="text"
            name="address"
            placeholder="Service Address"
            required
            class="w-full rounded-md border-2 border-white/15 bg-white px-3 py-2.5 text-sm text-brand-ink placeholder:text-brand-ink/50"
          />
          <select
            name="serviceType"
            required
            class="w-full rounded-md border-2 border-white/15 bg-white px-3 py-2.5 text-sm text-brand-ink"
          >
            <option>New System Installation</option>
            <option>Ductless Mini-Split</option>
            <option>Heat Pump</option>
            <option>Central Air Conditioning</option>
            <option>Furnace or Air Handler</option>
            <option>Not Sure Yet</option>
          </select>
          <textarea
            name="message"
            placeholder="Anything we should know about your home or current system?"
            rows="2"
            class="w-full rounded-md border-2 border-white/15 bg-white px-3 py-2.5 text-sm text-brand-ink placeholder:text-brand-ink/50"
          ></textarea>

          <label class="flex items-start gap-2 text-xs text-white/80">
            <input type="checkbox" required class="mt-1 shrink-0" />
            <span>By submitting this form, you agree to be contacted by Horizon HVAC about your inquiry.</span>
          </label>

          <button
            type="submit"
            class="w-full rounded-full bg-[#4ADE80] px-6 py-3.5 text-base font-extrabold text-[#06130B] shadow-[0_0_30px_rgba(74,222,128,0.45)] transition-opacity hover:opacity-90"
          >
            Get My Free Estimate
          </button>

          <p class="text-center text-xs text-white/70">
            Prefer to talk? Call
            <a href={PHONE_HREF} class="font-bold text-[#4ADE80] hover:underline">{PHONE_DISPLAY}</a>
          </p>
        </form>

        <p class="mt-4 text-center text-[11px] leading-relaxed text-white/50">
          Discount applies to qualifying new HVAC system installations and is confirmed at the time of quote. Offer
          ends {SALE_ENDS}. Licensed and insured. Serving Rhode Island and Massachusetts.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { wireQuoteForm } from "../scripts/quoteForm";

  const form = document.getElementById("black-friday-form") as HTMLFormElement | null;
  if (form) wireQuoteForm(form);
</script>
