---
import { googleReviewsUrl } from "../data/business";
---

<div class="flex flex-wrap items-center justify-center gap-6">
  <a
    href={googleReviewsUrl}
    target="_blank"
    rel="noopener"
    class="flex items-center gap-3 rounded-xl bg-white/10 px-5 py-3 hover:bg-white/20 transition-colors"
  >
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-brand-green font-extrabold text-lg">G</span>
    <div class="text-left">
      <div class="flex text-brand-gold">
        {Array.from({ length: 5 }).map(() => (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10 15.27L16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
          </svg>
        ))}
      </div>
      <p class="text-white text-sm font-bold">4.9 Rating</p>
    </div>
  </a>

  <div class="flex items-center gap-3 rounded-xl bg-white/10 px-5 py-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-gold text-brand-ink font-extrabold text-xs">24/7</span>
    <p class="text-white text-sm font-bold uppercase">Emergency<br />Service</p>
  </div>
</div>
