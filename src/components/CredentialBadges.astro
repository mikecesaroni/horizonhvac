---
const credentials = ["Licensed & Insured RI", "BBB Accredited A+", "25+ Yrs Experience"];
---

<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm font-semibold uppercase tracking-wide text-white/90">
  {credentials.map((credential, i) => (
    <>
      {i > 0 && <span class="text-brand-gold">•</span>}
      <span>{credential}</span>
    </>
  ))}
</div>
