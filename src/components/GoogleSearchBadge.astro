---
// A "review us on Google" trust badge — not a claim of enrollment in any paid
// Google certification program (e.g. "Google Guaranteed").
//
// Points at the review deep link rather than the profile, so the label matches
// what actually happens on click: the write-a-review dialog opens. Badges that
// say "review us" but land on a map pin lose the review.
import { googleWriteReviewUrl } from "../data/business";
---

<a
  href={googleWriteReviewUrl}
  target="_blank"
  rel="noopener"
  aria-label="Leave Horizon HVAC a review on Google (opens in a new tab)"
  class="inline-flex items-center gap-3 rounded-full bg-white px-5 py-3 shadow-lg"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" viewBox="0 0 48 48">
    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z" />
    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.9 18.9 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
    <path fill="#4CAF50" d="M24 44c5.5 0 10.5-2.1 14.3-5.6l-6.6-5.6C29.6 34.7 26.9 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.6 5.1C9.6 39.6 16.3 44 24 44z" />
    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.2-4.1 5.6l6.6 5.6C39.6 37.7 44 31.9 44 24c0-1.3-.1-2.7-.4-3.5z" />
  </svg>
  <span class="text-left leading-tight">
    <span class="block text-xs font-semibold text-brand-ink/60">Review Us on</span>
    <span class="block text-sm font-extrabold text-brand-ink">Google</span>
  </span>
</a>
