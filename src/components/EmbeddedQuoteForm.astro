---
// Same fields as QuoteFormModal.astro, just laid out inline in the page instead of a popup.
// Submits to GoHighLevel via netlify/functions/submit-quote.js — see src/scripts/quoteForm.ts.
---

<section class="bg-brand-green py-16">
  <div class="mx-auto max-w-2xl px-4 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-gold">Get Started</p>
    <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-white">Request Your Free Estimate</h2>
    <p class="mt-3 text-white/80">Fill out the form below and we'll get back to you shortly.</p>

    <form id="embedded-quote-form" class="mt-8 space-y-4 rounded-3xl border-4 border-white/20 bg-brand-green-dark/40 p-6 sm:p-8 text-left shadow-lg">
      <div class="grid gap-4 sm:grid-cols-2">
        <input
          type="text"
          name="firstName"
          placeholder="First Name"
          required
          class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink placeholder:text-brand-ink/50"
        />
        <input
          type="text"
          name="lastName"
          placeholder="Last Name"
          required
          class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink placeholder:text-brand-ink/50"
        />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <input
          type="tel"
          name="phone"
          placeholder="Phone Number"
          required
          class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink placeholder:text-brand-ink/50"
        />
        <input
          type="email"
          name="email"
          placeholder="Email Address"
          class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink placeholder:text-brand-ink/50"
        />
      </div>
      <input
        type="text"
        name="address"
        placeholder="Service Address"
        class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink placeholder:text-brand-ink/50"
      />
      <div class="grid gap-4 sm:grid-cols-2">
        <select
          name="serviceType"
          class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink"
        >
          <option>Install</option>
          <option>Repair</option>
          <option>Maintenance</option>
          <option>Emergency Service</option>
        </select>
        <input
          type="text"
          name="unitAge"
          placeholder="Unit Age"
          class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink placeholder:text-brand-ink/50"
        />
      </div>
      <textarea
        name="message"
        placeholder="Message"
        rows="3"
        class="w-full rounded-md border-2 border-white bg-white px-4 py-3 text-brand-ink placeholder:text-brand-ink/50"
      ></textarea>
      <label class="flex items-start gap-2 text-xs text-white/90">
        <input type="checkbox" required class="mt-1 shrink-0" />
        <span>
          By submitting this form, you agree to be contacted by Horizon HVAC about your inquiry.
        </span>
      </label>
      <button
        type="submit"
        class="w-full rounded-full bg-brand-gold px-6 py-3 font-bold text-brand-ink shadow-lg hover:opacity-90 transition-opacity"
      >
        Submit
      </button>
    </form>
  </div>
</section>

<script>
  import { wireQuoteForm } from "../scripts/quoteForm";

  const form = document.getElementById("embedded-quote-form") as HTMLFormElement | null;
  if (form) wireQuoteForm(form);
</script>
