---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="bg-brand-green">
  <div class="mx-auto max-w-6xl px-4 py-16 text-center text-white">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-brand-gold">{eyebrow}</p>}
    <h1 class="mt-2 text-4xl sm:text-5xl font-extrabold">{title}</h1>
    {description && <p class="mt-4 max-w-2xl mx-auto text-white/80">{description}</p>}
  </div>
</section>
