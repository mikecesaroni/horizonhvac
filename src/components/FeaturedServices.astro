---
import { services } from "../data/services";

const featured = services.filter((s) => s.featured);
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="text-center text-3xl sm:text-4xl font-extrabold uppercase text-brand-green">
    Our Featured Services
  </h2>

  <div class="mt-12 grid gap-8 sm:grid-cols-3">
    {featured.map((service) => (
      <div class="overflow-hidden rounded-2xl border-2 border-brand-green/30 shadow-sm">
        <!-- TODO: replace with a real photo for this service -->
        <div class="flex h-48 items-center justify-center bg-brand-green/10 text-brand-green/50 text-sm">
          Photo placeholder
        </div>
        <div class="bg-gradient-to-b from-brand-green to-brand-green-dark p-6 text-center text-white">
          <h3 class="text-xl font-extrabold uppercase">{service.name}</h3>
          <p class="mt-3 text-sm text-white/85">{service.description}</p>
          <a
            href={`/services/${service.slug}`}
            class="mt-5 inline-block rounded-full bg-brand-gold px-6 py-2.5 text-sm font-bold text-brand-ink hover:opacity-90 transition-opacity"
          >
            {service.name === "HVAC Emergencies" ? "HVAC Emergency Service" : `${service.name} Repair`}
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
