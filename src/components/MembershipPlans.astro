---
import { membershipPlans } from "../data/plans";
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-6xl px-4 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold uppercase text-brand-green">Comfort Club Membership</h2>
    <p class="mt-2 text-brand-ink/70">Skip the repair bills — join a maintenance plan and keep your system covered year-round.</p>

    <div class="mt-12 grid gap-8 sm:grid-cols-3 items-start">
      {membershipPlans.map((plan) => (
        <div
          class:list={[
            "relative overflow-hidden rounded-2xl border-4 bg-white shadow-lg transition-transform",
            plan.highlight ? "border-brand-gold sm:-translate-y-3 shadow-2xl" : "border-brand-green/15",
          ]}
        >
          {plan.badge && (
            <div class="absolute right-0 top-6 rounded-l-full bg-brand-gold px-4 py-1 text-xs font-bold uppercase tracking-wide text-brand-ink shadow">
              {plan.badge}
            </div>
          )}

          <div
            class:list={[
              "px-6 py-10 text-white",
              plan.highlight
                ? "bg-gradient-to-b from-brand-gold to-[#8a5f24]"
                : "bg-gradient-to-b from-brand-green to-brand-green-dark",
            ]}
          >
            <p class="text-lg font-extrabold uppercase tracking-wide">{plan.name}</p>
            <p class="mt-4 flex items-end justify-center gap-1 leading-none">
              <span class="text-5xl font-extrabold">{plan.price}</span>
              <span class="mb-1 text-sm font-semibold text-white/85">{plan.billing}</span>
            </p>
            <p class="mt-2 text-sm font-semibold text-white/85">{plan.annual}</p>
          </div>

          <div class="flex flex-wrap justify-center gap-x-6 gap-y-1 border-b border-brand-green/10 px-6 py-4 text-sm font-bold text-brand-green">
            <span>{plan.visits}</span>
            <span>{plan.discount}</span>
          </div>

          <ul class="space-y-3 px-6 py-6 text-left text-sm text-brand-ink/80">
            {plan.features.map((feature) => (
              <li class="flex gap-2">
                <span class="mt-0.5 shrink-0 font-bold text-brand-green">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="px-6 pb-6">
            <p class="mb-4 text-xs text-brand-ink/50">{plan.addOn}</p>
            <button
              type="button"
              data-open-quote-form
              class:list={[
                "w-full rounded-full px-6 py-3 font-bold shadow-lg transition-opacity hover:opacity-90",
                plan.highlight ? "bg-brand-gold text-brand-ink" : "bg-brand-green text-white",
              ]}
            >
              Join {plan.name}
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
