---
import { membershipPlans, annualPerk } from "../data/plans";

// Card layout mirrors the printed plan sheet: price block, the annual-prepay
// perk, the included benefits, then the per-plan extras (additional services on
// Essential, additional-system pricing on the other two).
//
// The extras block is NOT decoration. On Essential it carries the $179
// diagnostic fee, which is the single most important thing a buyer needs to see
// before choosing between plans, so it stays visible on the card rather than
// being buried in the terms.
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-6xl px-4 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold uppercase text-brand-green">Comfort Club Membership Plans</h2>
    <p class="mt-2 text-brand-ink/70">
      Protect your comfort, prevent breakdowns, and save on repairs. Pricing is per enrolled system.
    </p>

    <div class="mt-12 grid gap-8 lg:grid-cols-3 items-start">
      {membershipPlans.map((plan) => (
        <div
          class:list={[
            "flex h-full flex-col overflow-hidden rounded-2xl border-4 bg-white shadow-lg transition-transform",
            plan.highlight ? "border-brand-gold lg:-translate-y-3 shadow-2xl" : "border-brand-green/15",
          ]}
        >
          <div
            class:list={[
              "px-6 py-8 text-white",
              plan.highlight
                ? "bg-gradient-to-b from-brand-gold to-[#8a5f24]"
                : "bg-gradient-to-b from-brand-green to-brand-green-dark",
            ]}
          >
            {plan.badge && (
              <p class="mx-auto mb-4 w-fit rounded-full bg-white px-4 py-1 text-[11px] font-extrabold uppercase tracking-wider text-brand-ink shadow">
                {plan.badge}
              </p>
            )}
            <p class="text-lg font-extrabold uppercase tracking-wide">{plan.name}</p>
            <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-white/75">{plan.tagline}</p>

            <p class="mt-5 flex items-end justify-center gap-1 leading-none">
              <span class="text-5xl font-extrabold">{plan.monthly}</span>
              <span class="mb-1 text-sm font-semibold text-white/85">/mo per system</span>
            </p>

            <div class="mt-4 flex flex-wrap justify-center gap-2 text-xs font-semibold">
              <span class="rounded-md bg-white/15 px-3 py-1.5">{plan.perYear}</span>
              <span class="rounded-md bg-white px-3 py-1.5 text-brand-ink">{plan.annualPrepay}</span>
            </div>
            <p class="mt-3 text-xs font-bold uppercase tracking-wide text-white/90">{annualPerk}</p>
          </div>

          <div class="border-b border-brand-green/10 bg-brand-green/5 px-6 py-3 text-xs font-bold uppercase tracking-wide text-brand-green">
            Included benefits
          </div>

          <ul class="grow space-y-3 px-6 py-6 text-left text-sm text-brand-ink/80">
            {plan.benefits.map((benefit) => (
              <li class="flex gap-2">
                <span class="mt-0.5 shrink-0 font-bold text-brand-green">✓</span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>

          <div class="mx-6 mb-6 rounded-xl bg-brand-green/5 p-4 text-left">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-green">{plan.extras.heading}</p>
            <ul class="mt-2 space-y-1.5 text-xs leading-relaxed text-brand-ink/70">
              {plan.extras.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="px-6 pb-6">
            <button
              type="button"
              data-open-quote-form
              class:list={[
                "w-full rounded-full px-6 py-3 font-bold shadow-lg transition-opacity hover:opacity-90",
                plan.highlight ? "bg-brand-gold text-brand-ink" : "bg-brand-green text-white",
              ]}
            >
              Join {plan.name}
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
