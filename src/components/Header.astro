---
import TopBar from "./TopBar.astro";
import { navItems } from "../data/nav";
---

<header class="sticky top-0 z-50 bg-brand-green shadow-md">
  <TopBar />
  <div class="mx-auto max-w-7xl flex items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-white">
      <!-- TODO: replace with real logo asset -->
      <span class="text-2xl font-extrabold tracking-wide">HORIZON <span class="font-light">HVAC</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-white font-medium" aria-label="Primary">
      {navItems.map((item) => (
        <div class="relative group">
          <a href={item.href} class="hover:text-brand-gold transition-colors">
            {item.label}
          </a>
        </div>
      ))}
    </nav>

    <a
      href="/contact"
      class="hidden lg:inline-block rounded-md bg-brand-gold px-5 py-2 font-semibold text-brand-ink hover:opacity-90 transition-opacity"
    >
      Book Now
    </a>

    <button
      id="mobile-nav-toggle"
      class="lg:hidden text-white"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden lg:hidden bg-brand-green-dark px-4 pb-4" aria-label="Mobile">
    {navItems.map((item) => (
      <a href={item.href} class="block py-2 text-white border-b border-white/10">
        {item.label}
      </a>
    ))}
    <a
      href="/contact"
      class="mt-3 block rounded-md bg-brand-gold px-5 py-2 text-center font-semibold text-brand-ink"
    >
      Book Now
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isHidden));
  });
</script>
