---
// Reusable "sunrise over the horizon" section divider.
// `fromClass` is a bg-* (or gradient) class matching/fading from the PREVIOUS section's color —
// this is a real background on the wrapper, not a transparency trick, so there's never a gap.
// `toColorClass` is a text-* class controlling the wave's currentColor fill (the NEXT section's color).
// `side` positions the sun near one edge, alternate "left"/"right" between consecutive dividers.
interface Props {
  fromClass?: string;
  toColorClass?: string;
  side?: "left" | "right";
}
const { fromClass = "bg-white", toColorClass = "text-white", side = "left" } = Astro.props;
const cx = side === "left" ? 200 : 1240;
// "slice" scales X/Y uniformly (no squish) and crops overflow; anchor the crop to whichever
// edge the sun sits near so it never gets cropped out on narrow screens.
const preserveAspectRatio = side === "left" ? "xMinYMid slice" : "xMaxYMid slice";
const uid = Math.random().toString(36).slice(2, 9);

// The wave is made of cubic Bezier segments; find the one containing cx and solve for the
// curve's actual y there (via bisection on x, since x(t) isn't evenly spaced), so the sun's
// center always sits exactly ON the curve — precisely half hidden by it — instead of guessing.
type Pt = [number, number];
const segments: [Pt, Pt, Pt, Pt][] = [
  [[0, 148], [220, 196], [380, 88], [620, 112]],
  [[620, 112], [860, 136], [980, 82], [1160, 108]],
  [[1160, 108], [1300, 127], [1380, 170], [1440, 140]],
];

function bezierAt(seg: [Pt, Pt, Pt, Pt], t: number): Pt {
  const [p0, p1, p2, p3] = seg;
  const mt = 1 - t;
  const a = mt * mt * mt;
  const b = 3 * mt * mt * t;
  const c = 3 * mt * t * t;
  const d = t * t * t;
  return [
    a * p0[0] + b * p1[0] + c * p2[0] + d * p3[0],
    a * p0[1] + b * p1[1] + c * p2[1] + d * p3[1],
  ];
}

function curveYAtX(targetX: number): number {
  const seg = segments.find(([p0, , , p3]) => targetX >= p0[0] && targetX <= p3[0]) ?? segments[0];
  let lo = 0;
  let hi = 1;
  for (let i = 0; i < 40; i++) {
    const mid = (lo + hi) / 2;
    const [x] = bezierAt(seg, mid);
    if (x < targetX) lo = mid;
    else hi = mid;
  }
  return bezierAt(seg, (lo + hi) / 2)[1];
}

const cy = curveYAtX(cx);

const beamAngles = [-72, -54, -36, -18, 0, 18, 36, 54, 72];
const beamLengths = [34, 46, 54, 60, 64, 60, 54, 46, 34];

function beamPoints(angleDeg: number, len: number) {
  const rad = (angleDeg * Math.PI) / 180;
  const dx = Math.sin(rad);
  const dy = -Math.cos(rad);
  const baseHalfWidth = 4.5;
  const baseX = cx + dx * 44;
  const baseY = cy + dy * 44;
  const tipX = cx + dx * (44 + len);
  const tipY = cy + dy * (44 + len);
  const px = -dy;
  const py = dx;
  const x1 = baseX + px * baseHalfWidth;
  const y1 = baseY + py * baseHalfWidth;
  const x2 = baseX - px * baseHalfWidth;
  const y2 = baseY - py * baseHalfWidth;
  return `${x1},${y1} ${x2},${y2} ${tipX},${tipY}`;
}
---

<div class:list={["relative w-full overflow-hidden leading-[0]", fromClass]}>
  <svg class:list={["w-full h-32 sm:h-48", toColorClass]} viewBox="0 0 1440 200" fill="none" preserveAspectRatio={preserveAspectRatio}>
    <defs>
      <radialGradient id={`glow-${uid}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f4d78f" stop-opacity="0.5" />
        <stop offset="45%" stop-color="#d8b165" stop-opacity="0.2" />
        <stop offset="100%" stop-color="#d8b165" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`sun-${uid}`} cx="38%" cy="35%" r="70%">
        <stop offset="0%" stop-color="#fbeecb" />
        <stop offset="55%" stop-color="#e6c07d" />
        <stop offset="100%" stop-color="#c99a4d" />
      </radialGradient>
      <linearGradient id={`beam-${uid}`} x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#e9c988" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#e9c988" stop-opacity="0" />
      </linearGradient>
      <filter id={`shadow-${uid}`} x="-50%" y="-50%" width="200%" height="200%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#143f22" flood-opacity="0.3" />
      </filter>
    </defs>

    <ellipse cx={cx} cy={cy} rx="440" ry="85" fill={`url(#glow-${uid})`} />

    <g filter={`url(#shadow-${uid})`}>
      {beamAngles.map((angle, i) => (
        <polygon points={beamPoints(angle, beamLengths[i])} fill={`url(#beam-${uid})`} />
      ))}
      <circle cx={cx} cy={cy} r="38" fill={`url(#sun-${uid})`} />
      <circle cx={cx} cy={cy} r="38" fill="none" stroke="#b8863f" stroke-opacity="0.35" stroke-width="1.5" />
    </g>

    <path
      d="M0,148 C220,196 380,88 620,112 C860,136 980,82 1160,108 C1300,127 1380,170 1440,140 L1440,200 L0,200 Z"
      fill="currentColor"
    />
  </svg>
</div>
