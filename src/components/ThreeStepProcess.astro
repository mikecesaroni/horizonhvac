---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const steps = [
  {
    number: 1,
    title: "Call or Book Online",
    description:
      "Reach us by phone or click the booking button. Tell us what's wrong and we'll get you on the schedule — often same day.",
    icon: "phone",
  },
  {
    number: 2,
    title: "A Tech Arrives On Time",
    description:
      "Our licensed tech shows up in a clean, stocked truck. We diagnose the problem, explain the fix, and give you an upfront quote before any work begins.",
    icon: "clock",
  },
  {
    number: 3,
    title: "Problem Fixed. Guaranteed.",
    description:
      "We repair it right the first time and back every job with our 100% satisfaction guarantee. You don't pay until you're satisfied.",
    icon: "check",
  },
];
---

<section class:list={[dark && "bg-brand-green"]}>
  <div class="mx-auto max-w-6xl px-4 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-gold">
      Same-Day Service · 7 Days a Week
    </p>
    <h2 class:list={["mt-2 text-3xl sm:text-4xl font-extrabold", dark ? "text-white" : "text-brand-ink"]}>
      3 Steps to a Comfortable Home
    </h2>

    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {steps.map((step) => (
        <div class="flex flex-col items-center">
          <div
            class:list={[
              "relative flex h-24 w-24 items-center justify-center rounded-full",
              dark ? "bg-white text-brand-green" : "bg-brand-green text-white",
            ]}
          >
            <span class="absolute -top-2 -right-2 rounded-full bg-brand-gold px-2 py-0.5 text-xs font-bold text-brand-ink">
              Step {step.number}
            </span>
            {step.icon === "phone" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-9 w-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a2.25 2.25 0 00-2.328.638l-.727.727a11.25 11.25 0 01-6.06-6.06l.727-.727a2.25 2.25 0 00.638-2.328L6.913 4.352a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 5.75v1z" />
              </svg>
            )}
            {step.icon === "clock" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-9 w-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
              </svg>
            )}
            {step.icon === "check" && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-9 w-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z" />
              </svg>
            )}
          </div>
          <h3 class:list={["mt-4 text-xl font-bold", dark ? "text-white" : "text-brand-ink"]}>{step.title}</h3>
          <p class:list={["mt-2", dark ? "text-white/80" : "text-brand-ink/70"]}>{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
