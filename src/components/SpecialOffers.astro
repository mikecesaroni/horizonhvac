---
import { offers } from "../data/offers";
---

<section class="bg-brand-gold/10 py-16">
  <div class="mx-auto max-w-6xl px-4 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-14 w-14 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-2.25c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v2.25c0 .621.504 1.125 1.125 1.125z" />
    </svg>

    <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold uppercase text-brand-green">Our Special Offers</h2>

    <div class="mt-12 grid gap-8 sm:grid-cols-3">
      {offers.map((offer) => (
        <div class="overflow-hidden rounded-2xl border-4 border-brand-green/20 bg-white shadow-lg">
          <div class="bg-gradient-to-b from-brand-green to-brand-green-dark px-6 py-10 text-white">
            <p class="text-4xl sm:text-5xl font-extrabold">
              {offer.amount.replace(" OFF", "")}<span class="text-2xl align-top ml-1">OFF</span>
            </p>
            <p class="mt-3 font-bold uppercase tracking-wide">{offer.label}</p>
          </div>
          <div class="p-4">
            <!-- TODO: replace with real logo mark -->
            <span class="inline-block rounded-full bg-brand-green px-3 py-1 text-xs font-bold text-white">HORIZON HVAC</span>
            <p class="mt-2 text-xs text-brand-ink/60">{offer.fineprint}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/plans" class="rounded-full bg-brand-green px-8 py-3 font-bold text-white shadow-lg hover:opacity-90 transition-opacity">
        More Specials
      </a>
      <a href="tel:14014259879" class="rounded-full bg-brand-gold px-8 py-3 font-bold text-brand-ink shadow-lg hover:opacity-90 transition-opacity">
        Call 401-425-9879
      </a>
    </div>
  </div>
</section>
