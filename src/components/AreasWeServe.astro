---
import RhodeIslandMap from "./RhodeIslandMap.astro";

const highlightAreas = [
  { slug: "providence", name: "Providence" },
  { slug: "warwick", name: "Warwick" },
  { slug: "newport", name: "Newport" },
  { slug: "woonsocket", name: "Woonsocket" },
];
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="text-center lg:text-left">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-gold">Our Service Areas</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-brand-ink">Proudly Serving</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-brand-green">All of Rhode Island</p>
        <p class="mt-4 text-brand-ink/70">
          Committed to fast, reliable heating &amp; cooling service for the communities we call home.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-4">
          {highlightAreas.map((area) => (
            <a
              href={`/service-areas/${area.slug}`}
              class="flex items-center gap-3 rounded-2xl border border-brand-green/15 bg-brand-green/5 px-4 py-4 font-bold text-brand-ink shadow-sm hover:bg-brand-green/10 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 text-brand-gold" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.847 2.02 6.837 3.963 8.827a19.58 19.58 0 002.683 2.282 16.975 16.975 0 001.144.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
              </svg>
              {area.name} Area
            </a>
          ))}
        </div>

        <a
          href="/service-areas"
          class="mt-8 inline-block rounded-full bg-brand-green px-8 py-3 font-bold text-white shadow-lg hover:opacity-90 transition-opacity"
        >
          View All Service Areas
        </a>
      </div>

      <RhodeIslandMap />
    </div>
  </div>
</section>
