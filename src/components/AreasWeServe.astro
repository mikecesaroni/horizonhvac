---
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-5xl px-4 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-gold">Where We Work</p>
    <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-brand-ink">Areas We Serve</h2>
    <p class="mt-2 text-2xl sm:text-3xl font-extrabold text-brand-green">All of Rhode Island</p>

    <div class="mt-10 overflow-hidden rounded-3xl border-4 border-brand-green/15 shadow-lg">
      <iframe
        title="Map of Rhode Island — Horizon HVAC service area"
        src="https://maps.google.com/maps?q=Rhode+Island&z=9&output=embed"
        class="h-80 w-full sm:h-96"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <a
      href="/service-areas"
      class="mt-10 inline-block rounded-full bg-brand-green px-8 py-3 font-bold text-white shadow-lg hover:opacity-90 transition-opacity"
    >
      View All Service Areas
    </a>
  </div>
</section>
